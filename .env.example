# Optional — global leaderboard backend.
# Without these vars the leaderboard uses a local JSON file (.data/leaderboard.json):
# perfect for dev, but resets on serverless deploys. For a real global leaderboard,
# create a free Supabase project and run the SQL from README.md, then fill these in.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
